# ==============================================================================
# AUDIN BACKEND ENVIRONMENT CONFIGURATION (.env)
# ==============================================================================
# Petunjuk:
# 1. Salin berkas ini ke `server/.env` untuk penggunaan lokal.
# 2. Untuk Render / Produksi, masukkan variabel di bawah ini ke:
#    Render Dashboard -> Service Anda -> Environment -> Environment Variables.
# ==============================================================================

# Port server (default: 3001)
PORT=3001

# URL publik backend ini (PENTING untuk produksi/Render!)
# Contoh Render: https://audin-backend.onrender.com (tanpa trailing slash)
# Jika tidak disetel, akan default ke http://localhost:3001 yang menyebabkan
# audio tidak bisa diputar oleh pengguna di browser.
BASE_URL=http://localhost:3001

# URL frontend yang diizinkan untuk CORS (pisahkan koma jika lebih dari satu)
# Contoh: https://audins.vercel.app,https://audins.galihh.me
FRONTEND_URL=http://localhost:8443,http://localhost:5173,https://audins.vercel.app

# ==============================================================================
# KEAMANAN & AUTENTIKASI (Wajib diisi di Produksi untuk menghilangkan warning)
# Anda bisa menjalankan `npm run generate-secrets --prefix server` untuk membuat nilai random.
# ==============================================================================
# Secret untuk menandatangani JWT token autentikasi pengguna
JWT_SECRET=generate-random-64-char-hex-secret-with-npm-run-generate-secrets

# Secret untuk menandatangani URL akses berkas media audio lokal
MEDIA_SIGNING_SECRET=generate-random-64-char-hex-secret-with-npm-run-generate-secrets

# ==============================================================================
# AI INTELLIGENCE SERVICE (Wajib untuk transkripsi Whisper & ringkasan AI)
# ==============================================================================
# Dapatkan gratis di https://console.groq.com/keys
GROQ_API_KEY=gsk_your_groq_api_key_here

# Batas unggahan harian untuk akun demo/tamu gratis
MAX_FREE_DAILY_UPLOADS=10

# ==============================================================================
# PERSISTENT DATABASE & CLOUD STORAGE (Sangat direkomendasikan di Render!)
# ==============================================================================
# PENTING DI RENDER FREE TIER:
# Render Free Tier memiliki disk yang 'ephemeral' (terhapus saat server tidur/restart).
# Tanpa Supabase, dokumen dan audio lokal di Render akan hilang saat server restart.
# Dengan mengisi Supabase di bawah, data Anda tersimpan permanen di cloud!
#
# Bucket Storage yang dibutuhkan di Supabase: `audin-audio` (Public bucket)
# SUPABASE_URL=https://your-project.supabase.co
# SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1Ni...

# Opsional: Cloudflare R2 untuk penyimpanan audio
# R2_ENDPOINT=https://<account_id>.r2.cloudflarestorage.com
# R2_ACCESS_KEY_ID=your_r2_access_key
# R2_SECRET_ACCESS_KEY=your_r2_secret_key
# R2_BUCKET_NAME=audin-audio
# R2_PUBLIC_URL=https://pub-your-id.r2.dev
